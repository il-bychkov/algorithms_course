%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\begin{frame}
\frametitle{Ассоциативный массив}
\framesubtitle{Ассоциативный массив}
\justifying
\textcolor{red}{Ассоциативный массив/словарь/отображение (dictionary/map)}\newline
это структура данных, обобщающая понятие массива, позволяющая хранить и \newline обрабатывать данные по произвольным \textcolor{red}{ключам}.\newline

\textcolor{blue}{Обобщение массива} Индексы массива не обязательно могут быть числами \newline от 0 до N-1\newline

Поддержка в современных языках
\begin{itemize}
\item{Сторонние библиотеки: C, VisualBasic, Standard ML, bash, ...}
\item{Встроенные библиотеки: Java, C\#, C++, Scala, ...}
\item{Поддержка на уровне языка: Awk, Perl, PHP, Tcl, JavaScript, Python, Ruby, Lua}
\end{itemize}

\end{frame}



%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\begin{frame}
\frametitle{Ассоциативный массив}
\framesubtitle{Ассоциативный массив}

\textcolor{blue}{Пример - DNS lookup}
\begin{itemize}
  \item{Добавить URL с настоящим адресом}
  \item{Дан URL, необходимо узнать адрес}
\end{itemize}
