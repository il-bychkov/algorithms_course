    \captionsetup[subfigure]{labelformat=empty}
    \centering
        \subfigure[{ \scriptsize Источник - \href{https://algs4.cs.princeton.edu/home/}{Sedjwick, Wayne - algs4.cs.princeton.edu}}]{\includegraphics[width=90mm, height=50mm]{collision_chain_example1}} 
