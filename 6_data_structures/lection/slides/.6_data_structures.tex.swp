\begin{itemize}
\item{A=a[0]a[1]a[2]…a[i] – символы}
\item{Использовать все символы – хорошая практика, иначе возможно большое количество коллизий}
\item{Например, если a[0] не используется, hash(“aa”) = hash(“ba”) = … = hash(“za”)}\newline
\end{itemize}


