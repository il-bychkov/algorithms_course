\end{frame}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\begin{frame}
\frametitle{Ассоциативный массив}
\framesubtitle{Ассоциативный массив}
\textcolor{blue}{Ассоциативный массив.} Каждый элемент данных (значение) ассоциируется с некоторым идентификатором (ключ)\newline\newline
Функциональность:
\begin{itemize}
\item{put(key, value), обычно a[key] = value}
\item{put(key, value) перезаписывает старое значение новым}
\item{get(key), обычно a[key]}
\item{get(key) возвращает null если не существует значения по заданному ключу}\newline
\end{itemize}

Легкая реализация contains(key) и delete(key)

\end{frame}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\begin{frame}
\frametitle{Ассоциативный массив}
\framesubtitle{Возможные реализации}

\textcolor{blue}{Структура данных.} Связный список пар ключ-значение\newline\newline
\textcolor{blue}{Поиск.} Исследуем все элементы пока не найдем совпадение или не закончится список\newline\newline
\textcolor{blue}{Вставка.} Исследуем все элементы пока не найдем совпадения, если не нашли – вставляем в начало\newline

\end{frame}

