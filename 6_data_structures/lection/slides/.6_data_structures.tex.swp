%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\begin{frame}
\frametitle{Ассоциативный массив}
\framesubtitle{Метод цепочек}

\textcolor{blue}{Метод цепочек (chain hashing).} Используем массив из M < N связных списков. [H. P. Luhn, IBM 1953] .\newline\newline
\textcolor{blue}{Хэширование.} Отображение в целое число между 0 и M - 1. \newline\newline
\textcolor{blue}{Вставка.} вставка в начало цепи i (если элемента нет). \newline\newline
\textcolor{blue}{Поиск.} необходимость поиска только в цепи i. \newline\newline

\end{frame}


